# 🔹 LAYER 1: CDN (Cloudflare)
# Create account at https://cloudflare.com
# Images/videos CDN - no server load
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_DOMAIN=evolvefit.com

# 🔹 LAYER 2: Redis Cache
# Speed 10x improvement - Reduces database hits
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 🔹 LAYER 3: Queue System
# Heavy tasks background - Instant response
QUEUE_WORKER_CONCURRENCY=5
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379

# 🔹 LAYER 4: Horizontal Scaling
# Multiple instances + Load balancer
NODE_ENV=development
PORT=3000
INSTANCE_ID=1

# Frontend (Vite)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_BACKEND_BASE_URL=/api

# Backend API Keys
GOOGLE_GENAI_API_KEY=your_google_genai_api_key
GEMINI_API_KEY=your_gemini_api_key
HF_API_KEY=your_huggingface_api_key
OPENAI_API_KEY=your_openai_api_key

# Database
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# Feature Flags
DISABLE_HMR=false
USE_MOCK_AI=false
ENABLE_QUEUE_PROCESSING=true
